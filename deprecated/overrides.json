{
  "_comment": "tools/deprecated/generate.py 가 읽는 수기 맵. 키는 36-deprecated/*.md 의 심볼 표기와 같다(대소문자 무시, 괄호 생략 가능). 값은 문자열 또는 {replace, note}.",
  "replacements": {
    "Context::addJsFile()": { "replace": "Context::loadFile([$file, 'head'|'body', $targetie, $index])", "note": "2·3번 인자는 무시됨" },
    "Context::addCSSFile()": { "replace": "Context::loadFile([$file, $media, '', $index])" },
    "Context::unloadJsFile()": { "replace": "Context::unloadFile($file)" },
    "Context::unloadCSSFile()": { "replace": "Context::unloadFile($file)" },
    "Context::getDBType()": { "replace": "config('db.master.type')" },
    "Context::getDBInfo()": { "replace": "config('db.master')", "note": "`Rhymix\\Framework\\Config::get('db')`와 동일" },
    "Context::encodeIdna()": { "replace": "Rhymix\\Framework\\URL::encodeIdna()" },
    "Context::decodeIdna()": { "replace": "Rhymix\\Framework\\URL::decodeIdna()" },
    "Context::isAllowRewrite()": { "replace": "Rhymix\\Framework\\Router::getRewriteLevel()" },
    "Context::getSSLStatus()": { "replace": "Context::get('_use_ssl')", "note": "`RX_SSL` 상수도 참고" },
    "Context::pathToUrl()": { "replace": "Rhymix\\Framework\\URL::fromServerPath(FileHandler::getRealPath($path))", "note": "원본은 루트 상대 경로, 대체는 절대 URL(문서 루트 밖이면 false). 의미 차이 확인" },
    "Context::transContent()": { "replace": "없음", "note": "no-op, 인자를 그대로 반환" },
    "checkCSRF()": { "replace": "Rhymix\\Framework\\Security::checkCSRF()" },
    "removeHackTag()": { "replace": "Rhymix\\Framework\\Filters\\HTMLFilter::clean()" },
    "purifierHtml()": { "replace": "Rhymix\\Framework\\Filters\\HTMLFilter::clean()" },
    "get_time_zone_offset()": { "replace": "Rhymix\\Framework\\DateTime::getTimezoneOffsetByLegacyFormat()" },
    "stripEmbedTagForAdmin()": { "replace": "Rhymix\\Framework\\Filters\\MediaFilter::removeEmbeddedMedia($content, $msg)", "note": "관리자/작성자 판정은 호출부에서 수행" },
    "detectUTF8()": { "replace": "utf8_check()", "note": "$return_convert 변환 경로의 대체는 확인 필요" },
    "getSiteUrl()": { "replace": "Context::getUrl(..., $domain)", "note": "$domain은 사이트 정보 객체가 아닌 도메인 문자열. 객체를 넘기면 PHP 8에서 TypeError" },
    "getNotEncodedSiteUrl()": { "replace": "Context::getUrl(..., $domain)", "note": "네 번째 인자 false(HTML 이스케이프 없음)와 동일. $domain은 도메인 문자열" },
    "getFullSiteUrl()": { "replace": "Context::getUrl(..., $domain)", "note": "$domain은 도메인 문자열" },
    "getAutoEncodedUrl()": { "replace": "getUrl(...)" },
    "handleError()": { "replace": "Rhymix\\Framework\\Debug::addError()" },
    "Mobile::isMobileCheckByAgent()": { "replace": "Rhymix\\Framework\\UA::isMobile()" },
    "Mobile::isMobilePadCheckByAgent()": { "replace": "Rhymix\\Framework\\UA::isTablet()" },
    "Mobile::_isFromMobilePhone()": { "replace": "Mobile::isFromMobilePhone()" },
    "XeXmlParser::loadXmlFile()": { "replace": "Rhymix\\Framework\\Parsers\\XEXMLParser::loadXMLFile()" },
    "XeXmlParser::parse()": { "replace": "Rhymix\\Framework\\Parsers\\XEXMLParser::loadXMLString()" },
    "class XeXmlParser": { "replace": "Rhymix\\Framework\\Parsers\\XEXMLParser", "note": "`XmlParser`는 이 클래스의 class_alias" },
    "Rhymix\\Framework\\Filters\\MediaFilter::getIframeWhitelist()": { "replace": "Rhymix\\Framework\\Filters\\MediaFilter::getWhitelist()" },
    "Rhymix\\Framework\\Filters\\MediaFilter::getObjectWhitelist()": { "replace": "Rhymix\\Framework\\Filters\\MediaFilter::getWhitelist()" },
    "Rhymix\\Framework\\Filters\\MediaFilter::getIframeWhitelistRegex()": { "replace": "Rhymix\\Framework\\Filters\\MediaFilter::getWhitelistRegex()" },
    "Rhymix\\Framework\\Filters\\MediaFilter::getObjectWhitelistRegex()": { "replace": "Rhymix\\Framework\\Filters\\MediaFilter::getWhitelistRegex()" },
    "Rhymix\\Framework\\Filters\\MediaFilter::matchIframeWhitelist()": { "replace": "Rhymix\\Framework\\Filters\\MediaFilter::matchWhitelist()" },
    "Rhymix\\Framework\\Filters\\MediaFilter::matchObjectWhitelist()": { "replace": "Rhymix\\Framework\\Filters\\MediaFilter::matchWhitelist()" },
    "Rhymix\\Framework\\Filters\\MediaFilter::addIframePrefix()": { "replace": "Rhymix\\Framework\\Filters\\MediaFilter::addPrefix()" },
    "Rhymix\\Framework\\Filters\\MediaFilter::addObjectPrefix()": { "replace": "Rhymix\\Framework\\Filters\\MediaFilter::addPrefix()" },
    "Rhymix\\Framework\\DB::db_fetch_object()": { "replace": "$stmt->fetchObject()" },
    "Rhymix\\Framework\\DB::db_free_result()": { "replace": "$stmt->closeCursor()" },
    "Rhymix\\Framework\\DB::db_insert_id()": { "replace": "$db->getInsertID()" },
    "Rhymix\\Framework\\DB::createTableByXmlFile()": { "replace": "$db->createTable($filename)" },
    "Rhymix\\Framework\\DB::create()": { "replace": "DB::getInstance()" },
    "MemberController::procMemberSaveDocument()": { "replace": "DocumentController::procDocumentTempSave()" },
    "class AdminAdminController": { "replace": "Rhymix\\Modules\\Admin\\Controllers\\*" },
    "class AdminAdminModel": { "replace": "Rhymix\\Modules\\Admin\\Controllers\\*" },
    "class AdminAdminView": { "replace": "Rhymix\\Modules\\Admin\\Controllers\\*" },
    "file common/scripts/clean_empty_dirs.php": { "replace": "php index.php file.cleanEmptyDirs" },
    "file common/scripts/clean_garbage_files.php": { "replace": "php index.php file.cleanGarbageFiles" },
    "file common/scripts/clean_message_files.php": { "replace": "php index.php communication.cleanMessageFiles" },
    "file common/scripts/clean_old_logs.php": { "replace": "php index.php module.cleanMiscLogs" },
    "file common/scripts/clean_old_notifications.php": { "replace": "php index.php ncenterlite.cleanNotifications" },
    "file common/scripts/clean_old_thumbnails.php": { "replace": "php index.php file.cleanThumbnails" },
    "file common/scripts/update_all_modules.php": { "replace": "php index.php module.updateAllModules" },
    "class Security": { "replace": "Rhymix\\Framework\\Security" },
    "class Password": { "replace": "Rhymix\\Framework\\Password" },
    "class IpFilter": { "replace": "Rhymix\\Framework\\Filters\\IpFilter" },
    "class Purifier": { "replace": "Rhymix\\Framework\\Filters\\HTMLFilter" },
    "class EmbedFilter": { "replace": "Rhymix\\Framework\\Filters\\MediaFilter" },
    "class XEHttpRequest": { "replace": "Rhymix\\Framework\\HTTP" },
    "getCookie()": { "replace": "Rhymix.cookie.get(name)" },
    "setCookie()": { "replace": "Rhymix.cookie.set(name, value, options)" },
    "doCallModuleAction()": { "replace": "Rhymix.ajax(action, params, callback)" },
    "class Object": { "replace": "BaseObject", "note": "PHP 7.2 예약어. 2.0.24까지 PHP<7.2에서만 alias, 현재 없음" },
    "setUserSequence()": { "replace": "없음", "note": "getNextSequence()가 내부에서 호출" },
    "checkUserSequence()": { "replace": "없음" },
    "getEncodeEmailAddress()": { "replace": "없음" },
    "delObjectVars()": { "replace": "없음" },
    "getDestroyXeVars()": { "replace": "없음" }
  },
  "removed": {
    "include": [],
